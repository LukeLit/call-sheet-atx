# Cheap /admin gate. If unset, /admin shows "not configured" and the public site stays up.
ADMIN_SECRET=

# Optional comma-separated Muse chain. Used when Edge Config has no muse_models value.
# Example: poolside/laguna-s-2.1-free,alibaba/qwen3.8-27b,alibaba/qwen3.7-flash
MUSE_MODELS=

# Set automatically when you connect an Edge Config / Global Config store to the project.
# EDGE_CONFIG=
# GLOBAL_CONFIG=

# Official write path is the Vercel REST API. There is no dedicated Edge Config write env.
# Create a Vercel Access Token and set it here so /admin can persist muse_models live.
# VERCEL_ACCESS_TOKEN=
